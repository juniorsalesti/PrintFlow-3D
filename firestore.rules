      allow update: if isVerifiedUser() && isValidId(userId) && isValidUser(incoming(), userId) && (
        isAdmin() || (
          userId == request.auth.uid &&
          incoming().uid == existing().uid &&
          incoming().companyId == existing().companyId &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
